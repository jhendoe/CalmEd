
@page "/login"
@using System.ComponentModel.DataAnnotations
@using CalmEd.Services
@inject AuthState Auth
@inject NavigationManager Nav

<div class="min-h-screen bg-[#f4f6ee] flex items-center justify-center px-4 py-10">
    <div class="w-full max-w-md rounded-3xl bg-white p-8 shadow-lg">
        <div class="text-center mb-8">
            <div class="text-4xl mb-3">🌿</div>
            <h1 class="text-3xl font-bold text-[#334b3f]">Welcome Back</h1>
            <p class="mt-2 text-gray-500">
                Take a breath. You're in your space.
            </p>
        </div>

        <EditForm Model="model" OnValidSubmit="LoginUser"
                  class="space-y-5">
            <DataAnnotationsValidator />

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">
                    Email
                </label>
                <InputText @bind-Value="model.Email" type="email"
                    class="w-full rounded-xl border border-gray-300 px-4 py-3 focus:border-[#77947a] focus:outline-none"
                    placeholder="you@example.com" />
                <ValidationMessage For="@(() => model.Email)"
                    class="text-sm text-red-600" />
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">
                    Password
                </label>
                <InputText @bind-Value="model.Password" type="password"
                    class="w-full rounded-xl border border-gray-300 px-4 py-3 focus:border-[#77947a] focus:outline-none"
                    placeholder="Enter your password" />
                <ValidationMessage For="@(() => model.Password)"
                    class="text-sm text-red-600" />
            </div>

            @if (!string.IsNullOrWhiteSpace(message))
            {
                <p role="alert" class="text-sm text-red-600">@message</p>
            }

            <button type="submit"
                class="w-full rounded-xl bg-[#6f8b72] py-3 font-semibold text-white transition hover:bg-[#58735c]">
                Log In
            </button>
        </EditForm>

        <p class="mt-6 text-center text-sm text-gray-600">
            New to CalmEd?
            <a href="/register" class="font-semibold text-[#58735c] hover:underline">
                Create an account
            </a>
        </p>
    </div>
</div>

@code {
    private LoginForm model = new();
    private string message = "";

    private void LoginUser()
    {
        var success = Auth.Login(
            model.Email.Trim(),
            model.Password,
            out message);

        if (success)
        {
            Nav.NavigateTo("/dashboard");
        }
    }

    private class LoginForm
    {
        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Enter a valid email.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Password is required.")]
        public string Password { get; set; } = "";
    }
}